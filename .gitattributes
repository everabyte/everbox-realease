# Installateurs en Git LFS (GitHub limite un fichier standard à 100 Mo —
# un installateur EverBox dépasse facilement ; sans LFS le push est rejeté).
# LFS doit rester activé sur le repo (Settings → Archives/LFS).
*.exe    filter=lfs diff=lfs merge=lfs -text
*.msi    filter=lfs diff=lfs merge=lfs -text
*.msix   filter=lfs diff=lfs merge=lfs -text
*.appx   filter=lfs diff=lfs merge=lfs -text
*.dmg    filter=lfs diff=lfs merge=lfs -text
*.pkg    filter=lfs diff=lfs merge=lfs -text
*.deb    filter=lfs diff=lfs merge=lfs -text
*.rpm    filter=lfs diff=lfs merge=lfs -text
*.AppImage filter=lfs diff=lfs merge=lfs -text

# Texte : jamais de conversion de fin de ligne sur les flux consommés par
# l'application (SHA-256 des manifests calculé sur le contenu publié).
CHANGELOG.json -text
**/latest.json -text
*.md text=auto
